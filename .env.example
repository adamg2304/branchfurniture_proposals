# HubSpot Private App token. Scopes needed: crm.objects.deals (read+write),
# crm.objects.quotes (read), crm.objects.line_items (read),
# crm.objects.contacts (read), crm.objects.companies (read),
# crm.objects.owners (read).
HUBSPOT_TOKEN=

HUBSPOT_PORTAL_ID=5361087

# Optional override for the deal property the tokenized link is written to.
# Defaults to hub_quote_link.
HUBSPOT_QUOTE_LINK_PROPERTY=

# This service's own public URL (no trailing slash), e.g. your Repl's URL or
# https://quotes.branchfurniture.com once DNS is set.
PUBLIC_BASE_URL=

# Zapier catch hook that advances the deal to the accepted stage and writes
# the audit note.
ACCEPT_WEBHOOK_URL=

# Shared secret the HubSpot "Quote Ready" workflow sends in the body of its
# POST /generate-link call. Keep this random and long.
GENERATE_WEBHOOK_SECRET=

# Optional: path to the token store JSON file. Defaults to
# <repo root>/.token-store.json.
TOKEN_STORE_PATH=

PORT=3000
