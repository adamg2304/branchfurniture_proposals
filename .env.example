# HubSpot private app access token (Settings > Integrations > Private Apps)
HUBSPOT_PRIVATE_APP_TOKEN=

# Client secret shown on the private app's Webhooks tab — used to verify
# X-HubSpot-Signature-v3 on inbound webhook calls. Required.
HUBSPOT_WEBHOOK_CLIENT_SECRET=

# The exact public URL HubSpot is configured to POST webhooks to, including
# path (e.g. https://proposals.branchfurniture.com/webhooks/hubspot/quotes).
# Needed because the v3 signature is computed over the full request URI as
# HubSpot sees it, which can differ from what an app behind a proxy/load
# balancer reconstructs from the incoming request.
HUBSPOT_WEBHOOK_TARGET_URL=

# Slack incoming webhook URL for the channel that should hear about
# accepted quotes.
SLACK_WEBHOOK_URL=

# Default quote template ID to attach to new quotes (Settings > Objects >
# Quotes > Templates). Required for src/hubspot/quotes.ts.
HUBSPOT_QUOTE_TEMPLATE_ID=

# Optional: dealstage ID to move a deal to once its quote is accepted
# (Settings > Objects > Deals > Pipelines > [pipeline] > stage IDs). Leave
# blank to skip automatic stage changes.
HUBSPOT_DEAL_STAGE_ON_ACCEPTED=

# Optional: portal/hub ID, only used to build a clickable HubSpot link in
# the Slack notification.
HUBSPOT_PORTAL_ID=

PORT=3000
